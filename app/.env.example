# Copy to .env and fill in your Supabase project values (Project Settings > API).
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time — never
# put a service_role key or secret here, only the public anon key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Places API key is used server-side (Backend API / Supabase, per
# architecture.md 3.1) for store location lookups — it must NOT be exposed
# to the client as an EXPO_PUBLIC_ var. Set it as a Supabase Edge Function
# secret instead: `supabase secrets set GOOGLE_PLACES_API_KEY=...`
