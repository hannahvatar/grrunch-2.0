# Copy to .env and fill in your Supabase project values (Project Settings > API).
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time — never
# put a service_role key or secret here, only the public anon key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Places API key is used server-side only, by the nearest-stores
# Edge Function (supabase/functions/nearest-stores) — it must NOT be exposed
# to the client as an EXPO_PUBLIC_ var. Set it as a Supabase secret instead,
# from the repo root:
#   npx supabase secrets set GOOGLE_PLACES_API_KEY=your-key-here

# RevenueCat public SDK keys (Project Settings > API Keys in the RevenueCat
# dashboard, once the iOS/Android apps are registered there) — safe as
# EXPO_PUBLIC_ vars, same trust level as the Supabase anon key above.
# lib/purchases.tsx no-ops gracefully (falls back to the DB-only free
# trial) as long as these are unset, so leaving them blank is fine until
# the Apple/Google/RevenueCat accounts exist.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# RevenueCat webhook secret — a value YOU pick, entered in both places:
# RevenueCat dashboard (Project Settings > Integrations > Webhooks >
# Authorization header) and this Supabase project's own secrets (NOT
# this .env file — the webhook runs server-side in
# supabase/functions/revenuecat-webhook, from the repo root:
#   npx supabase secrets set REVENUECAT_WEBHOOK_SECRET=your-chosen-secret
# Until this is set, the webhook safely 401s every request rather than
# writing unauthenticated subscription state.
