{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "grrunch-web",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "npm run web --prefix app -- --port \"${PORT:-8081}\""
      ],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "grrunch-metro",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd app && npx expo start --dev-client --port \"${PORT:-8082}\""
      ],
      "port": 8082,
      "autoPort": true
    },
    {
      "name": "grrunch-website",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "node website/build.mjs && python3 -m http.server \"${PORT:-8090}\" -d website/dist"
      ],
      "port": 8090,
      "autoPort": true
    }
  ]
}